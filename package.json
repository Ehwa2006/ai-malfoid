{
  "name": "ai-malfoid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ollama + AIRI 스타일로 만든 드레이코 말포이 데이팅 채팅",
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:vr": "node scripts/start.mjs --vr",
    "voice:install": "node scripts/gpt-sovits/install.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "unity:data": "vitest run scripts/unity -u"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "msedge-tts": "^2.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  }
}
